; mamba_scan_demo.m3asm — SSM_SCAN/RESET + ROPE + CTX_SWITCH (ISA 0x13/0x14/0x18/0x19)
; Uso:
;   cargo run --bin m3_avm -- run programs/mamba_scan_demo.m3asm --max-steps 40
; Semântica:
;   x=[1,2], h=[2,1] (tensor puro) com defaults dt=1,A=-1,B=C=1,D=0.
;   Scan é atômico/preemptível; RESET restaura h p/ barge-in (tese §5).

TENSOR r0 1 2 f32
TENSOR r1 2 1 f32
CTX_SWITCH MAMBA, GREEN
SSM_SCAN r5, r0, r1, r0 D_INNER=2 D_STATE=1 LAYER=0
ROPE r2, r0 POS=0 HDIM=2 NHEADS=1
ADD r0, r0, r5
SENSE r15, USER_INPUT
IF_INTERRUPT HANDLE_ABORT
JUMP DONE
HANDLE_ABORT:
    SSM_RESET r1 D_INNER=2 D_STATE=1
    JUMP DONE
DONE:
    HALT
