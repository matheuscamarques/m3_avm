; thinking_long.m3asm — demo interativo longo (300 iterações, ~30s)
; Cada iteração: SENSE VAD + SENSE AUDIO + FORK GREEN + FORK RED + NORM + ATTN + NORM + FFN + STREAM + SENSE VAD + ABORT
TENSOR r0 2 8 f32
TENSOR r1 1 8 f32
TENSOR r2 1 8 f32
TENSOR r3 8 8 f32
TENSOR r4 8 8 f32
TENSOR r5 8 16 f32
TENSOR r6 16 8 f32
; --- iter 0 ---
SENSE r10, VAD
SENSE r11, AUDIO
FORK r12, GREEN, NOTIFY
FORK r13, RED, NOTIFY
NORM r7, r0, r1, r2
ATTN r8, r7, r3, r3
NORM r9, r8, r1, r2
FFN r10, r9, r5, r6
STREAM r10, r15 BLOCKING
SENSE r14, VAD
ABORT r13, r12
ABORT r12, r15
