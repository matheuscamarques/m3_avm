; loop22_kv.m3asm — mesmo que examples/loop22_kv.m3asm (para CLI run)
TENSOR r0 1 8 f32
TENSOR r1 1 8 f32
TENSOR r2 1 8 f32
TENSOR r3 8 8 f32
TENSOR r4 8 8 f32
TENSOR r5 8 8 f32
TENSOR r6 8 8 f32
TENSOR r7 8 16 f32
TENSOR r8 16 8 f32
TENSOR r9 1 8 f32
SENSE r10, VAD
FORK r15, GREEN, NOTIFY
NORM r10, r0, r1, r2
ATTN r11, r10, r3, r3 NOTIFY_EACH_HEAD
ATTN r12, r10, r4, r5
NORM r10, r12, r9, r2
FFN r13, r10, r7, r8
STREAM r13, r15 BLOCKING
NORM r10, r13, r1, r2
ATTN r11, r10, r3, r3 NOTIFY_EACH_HEAD
NORM r10, r11, r9, r2
FFN r13, r10, r7, r8
NORM r10, r13, r1, r2
ATTN r11, r10, r3, r3 NOTIFY_EACH_HEAD
NORM r10, r11, r9, r2
FFN r14, r10, r7, r8
STREAM r14, 2 BLOCKING
SENSE r10, TOKEN
STREAM r10, 4 BLOCKING
SENSE r10, VAD
ABORT r15, r15
HALT
