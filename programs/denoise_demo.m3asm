; denoise_demo.m3asm — passo de difusão determinístico (RFC-0013)
; Uso:
;   cargo run --bin m3_avm -- run programs/denoise_demo.m3asm --max-steps 30
; Semântica (fumaça de fiação; numéricos nos goldens):
;   r0 = x [2,2] (ramp), r1 = eps [2,2] (ramp).
;   3x DENOISE_STEP encadeados (rD religado; ALPHA=0.98 BETA=0.02
;   SIGMA=0.0 => determinístico, sem draw de RNG).
;   STREAM rD -> saída. HALT.

TENSOR r0 2 2 f32
TENSOR r1 2 2 f32
DENOISE_STEP r4, r0, r1 ALPHA=0.98 BETA=0.02 SIGMA=0.0 T=500
DENOISE_STEP r4, r4, r1 ALPHA=0.97 BETA=0.03 SIGMA=0.0 T=499
DENOISE_STEP r4, r4, r1 ALPHA=0.96 BETA=0.04 SIGMA=0.0 T=498
STREAM r4, OUTPUT BLOCKING
HALT
